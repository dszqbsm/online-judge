syntax = "v1"

info (
	title:   "online-judge"
	desc:    "在线判题系统"
	version: "v1.0.0"
	author:  "shijiahao"
	email:   "570209909@qq.com"
)

type GeneralResponse {
	StatusCode int `json:"-"`
}

type (
	CreateUserRequest {
		UserName string `json:"user_name"`
		Password string `json:"password"`
	}
	CreateUserTokenRequest {
		UserName string `json:"user_name"`
		Password string `json:"password"`
	}
	TokenDetail {
		Token string `json:"token"`
	}
	CreateUserTokenResponse {
		StatusCode int         `json:"-"`
		Data       TokenDetail `json:"data"`
	}
)

@server (
	group:      v1/users
	middleware: LogInterceptor
)
service onlinejudge {
	@doc "用户注册"
	@handler CreateUser
	post /v1/users (CreateUserRequest) returns (GeneralResponse)

	@doc "用户登录"
	@handler CreateUserToken
	post /v1/users/auth/token (CreateUserTokenRequest) returns (CreateUserTokenResponse)
}

@server (
	group:      v1/problems
	middleware: LogInterceptor
)
service onlinejudge {
	@doc "获取题目列表"
	@handler CreateUser
	post /v1/users (CreateUserRequest) returns (GeneralResponse)

	@doc "获取题目详情"
	@handler CreateUserToken
	post /v1/users/auth/token (CreateUserTokenRequest) returns (CreateUserTokenResponse)

	@doc "创建题目详情"
	@handler CreateUserToken
	post /v1/users/auth/token (CreateUserTokenRequest) returns (CreateUserTokenResponse)

	@doc "更新题目详情"
	@handler CreateUserToken
	post /v1/users/auth/token (CreateUserTokenRequest) returns (CreateUserTokenResponse)

	@doc "删除题目详情"
	@handler CreateUserToken
	post /v1/users/auth/token (CreateUserTokenRequest) returns (CreateUserTokenResponse)
}

