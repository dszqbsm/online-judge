syntax = "v1"

info (
	title:   "online-judge"
	desc:    "在线判题系统"
	version: "v1.0.0"
	author:  "shijiahao"
	email:   "570209909@qq.com"
)

type GeneralResponse {
	StatusCode int `json:"-"`
}

type (
	CreateUserRequest {
		UserName string `json:"user_name"`
		Password string `json:"password"`
	}
	CreateUserTokenRequest {
		UserName string `json:"user_name"`
		Password string `json:"password"`
	}
	TokenDetail {
		Token string `json:"token"`
	}
	CreateUserTokenResponse {
		GeneralResponse
		Data       TokenDetail `json:"data"`
	}
)

@server (
	group:      v1/users
	middleware: LogInterceptor
)
service onlinejudge {
	@doc "用户注册"
	@handler CreateUser
	post /v1/users (CreateUserRequest) returns (GeneralResponse)

	@doc "用户登录"
	@handler CreateUserToken
	post /v1/users/auth/token (CreateUserTokenRequest) returns (CreateUserTokenResponse)
}

type (
	RetrieveProblemsRequest {
		Title      string `form:"title",optional`
		Difficulty string `form:"difficulty",optional`
		Tags       string `form:"tags",optional`
	}
	ProblemListDetail {
		ProblemKey string `json:"problem_key"`
		Title      string `json:"title"`
		Difficulty string `json:"difficulty"`
		Tags       string `json:"tags"`
	}
	RetrieveProblemsResponse {
		GeneralResponse
		Data []ProblemListDetail `json:"data"`
	}
	RetrieveProblemDetailRequest {
		ProblemKey string `path:"problem_key"`
	}
	ProblemDetail {
		Title       string `json:"title"`
		Description string `json:"description"`
		Inputdesc   string `json:"input_desc"`
		Outputdesc  string `json:"output_desc"`
		SampleCases string `json:"sample_ceses"`
		Difficulty  string `json:"difficulty"`
		TimeLimit   int    `json:"time_limit"`
		MemoryLimit int    `json:"memory_limit"`
		Tags        string `json:"tags"`
	}
	RetrieveProblemDetailResponse {
		GeneralResponse
		Data ProblemDetail `json:"data"`
	}
	CreateProblemDetailRequest {
		Title       string `json:"title"`
		Description string `json:"description"`
		Inputdesc   string `json:"input_desc"`
		Outputdesc  string `json:"output_desc"`
		SampleCases string `json:"sample_ceses"`
		Difficulty  string `json:"difficulty"`
		TimeLimit   int    `json:"time_limit"`
		MemoryLimit int    `json:"memory_limit"`
		Tags        string `json:"tags"`
		IsPublished bool   `json:"is_published"`
	}
	UpdateProblemDetailRequest {
		ProblemKey  string `path:"problem_key"`
		Title       string `json:"title",optional`
		Description string `json:"description",optional`
		Inputdesc   string `json:"input_desc",optional`
		Outputdesc  string `json:"output_desc",optional`
		SampleCases string `json:"sample_ceses",optional`
		Difficulty  string `json:"difficulty",optional`
		TimeLimit   int    `json:"time_limit",optional`
		MemoryLimit int    `json:"memory_limit",optional`
		Tags        string `json:"tags",optional`
		IsPublished bool   `json:"is_published",optional`
	}
	DeleteProblemDetailRequest {
		ProblemKey string `path:"problem_key"`
	}
)

@server (
	jwt:        Auth
	group:      v1/problems
	middleware: LogInterceptor
)
service onlinejudge {
	@doc "获取题目列表"
	@handler RetrieveProblems
	get /v1/problems (RetrieveProblemsRequest) returns (RetrieveProblemsResponse)

	@doc "获取题目详情"
	@handler RetrieveProblemDetail
	get /v1/problems/:problem_key (RetrieveProblemDetailRequest) returns (RetrieveProblemDetailResponse)

	@doc "创建题目详情"
	@handler CreateProblemDetail
	post /v1/problems (CreateProblemDetailRequest) returns (GeneralResponse)

	@doc "更新题目详情"
	@handler UpdateProblemDetail
	put /v1/problems/:problem_key (UpdateProblemDetailRequest) returns (GeneralResponse)

	@doc "删除题目详情"
	@handler DeleteProblemDetail
	delete /v1/problems/:problem_key (DeleteProblemDetailRequest) returns (GeneralResponse)
}

